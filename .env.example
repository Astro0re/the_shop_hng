PORT=3001
APP_URL=http://localhost:5173

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Brevo transactional mail. BREVO_API is an API key, not an SMTP password.
BREVO_API=your-brevo-api-key
BREVO_FROM=verified-sender@your-domain.com

# Optional: when set, SMTP takes priority over the Brevo API.
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587

# Optional legacy fallback if Brevo is not configured.
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_FROM=The Shop <postmaster@your-mailgun-domain>
# MAILGUN_API_URL=https://api.eu.mailgun.net
